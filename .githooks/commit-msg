#!/bin/sh
# Refuse tout message de commit attribuant le travail à un outil automatisé.
if grep -qiE 'co-authored|generated (with|by)|claude|anthropic|chatgpt|openai|copilot|\bAI-generated\b|\bassistant\b|claude\.(ai|com)' "$1"; then
  echo "commit-msg : message refusé (mention interdite)." >&2
  exit 1
fi
